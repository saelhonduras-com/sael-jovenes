# Copia este archivo como ".env" (sin ".example") y rellena los valores reales.
# El .env real NUNCA se sube a GitHub (ya está en .gitignore).

# Cadena de conexión de Neon (PostgreSQL)
# La obtienes en tu proyecto de Neon > Connection Details
DATABASE_URL=postgresql://usuario:password@host.neon.tech/nombre_db?sslmode=require

# Puerto local del backend
PORT=4000

# Entorno
NODE_ENV=development
